<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Aceptación Garantía Extendida"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Deseo incluir Garantía Extendida [Descripción GEX] por un valor de S/ XXX al artículo [Descripción]. Dejo mi firma en señal de conformidad:"
        android:textColor="#555555"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/tvVerDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:padding="4dp"
        android:text="ver detalle"
        android:textColor="#0056b3"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.pedidos.android.persistence.utils.DrawCustomView
        android:id="@+id/viewFirma"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="@color/colorBackground" />

    <TextView
        android:id="@+id/tvLimpiar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:padding="4dp"
        android:text="Limpiar firma"
        android:textColor="#0056b3"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbPolitica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvPoliticaLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="He leído y acepto la Política de Privacidad"
            android:textColor="#0056b3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNombreCompleto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Nombre completo: [Nombre del cliente]"
        android:textColor="#777777"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDoi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="DOI: [Tipo y número de documento]"
        android:textColor="#777777"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email: "
            android:textColor="#777777"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textSize="13sp"
            android:textColor="#000000"
            tools:text="email@cliente.com" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRechazar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#FF0000"
            android:text="RECHAZAR"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#8BC34A"
            android:text="CONTINUAR"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>